+def get_core_file_stats():
+    """Estimate core file entries based on size"""
+    csv_dir = Path("csvfiles")
+    stats = {}
+    if csv_dir.exists():
+        for f in csv_dir.glob("*.csv"):
+            # Estimate: ~50 bytes per line for typical OBP CSVs
+            stats[f.stem] = max(1, f.stat().st_size // 50)
+    return stats
